  "targets": [
    {
      "name": "CryptomatorCryptoLib",
      "id": "4A7C21312451F2AC00DE81E6",
      "product": "Products/CryptomatorCryptoLib.framework",
      "product-type": "framework",
      "last-swift-migration": "11.0",
      "dependencies": [
        "scrypt",
      ],
      "build-phases": [
        "headers",
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Lint With SwiftFormat",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "PATH=$PATH:/opt/homebrew/bin",
            "if which swiftformat >/dev/null; then",
            "  swiftformat --lint --lenient .",
            "else",
            "  echo \"warning: SwiftFormat not installed, download from https://github.com/nicklockwood/SwiftFormat\"",
            "fi",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Lint With SwiftLint",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "PATH=$PATH:/opt/homebrew/bin",
            "if which swiftlint >/dev/null; then",
            "  swiftlint",
            "else",
            "  echo \"warning: SwiftLint not installed, download from https://github.com/realm/SwiftLint\"",
            "fi",
            "",
          ],
        }, {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "DEFINES_MODULE": "YES",
        "DYLIB_COMPATIBILITY_VERSION": "1",
        "DYLIB_CURRENT_VERSION": "1",
        "DYLIB_INSTALL_NAME_BASE": "@rpath",
        "INFOPLIST_FILE": "Sources/CryptomatorCryptoLib/Info.plist",
        "INSTALL_PATH": "$(LOCAL_LIBRARY_DIR)/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "org.cryptomator.cryptolib",
        "PRODUCT_NAME": "$(TARGET_NAME:c99extidentifier)",
        "SKIP_INSTALL": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "scrypt",
      "id": "749260CD25B17A9A004B3426",
